# Copy to .env and fill in real values. Never commit .env.

# --- OpenAI-compatible provider (OpenAI, Groq, Together, vLLM, LM Studio, ...) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama / local provider ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Harness settings ---
HARNESS_DB_PATH=harness.db
HARNESS_PRICING_PATH=config/pricing.yaml
HARNESS_REPORTS_DIR=reports
HARNESS_MAX_CONCURRENCY=4
HARNESS_TIMEOUT_S=60
HARNESS_MAX_RETRIES=3
